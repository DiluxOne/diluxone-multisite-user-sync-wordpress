# PHPStan configuration for wpm-user-sync.
#
# Level 8 (max strictness). The WordPress extension
# (szepeviktor/phpstan-wordpress) is auto-registered via the
# phpstan/extension-installer composer plugin — no manual `includes:`
# needed for it.
#
# Zero errors, no baseline: a finding is fixed, never recorded.

parameters:
  level: 8

  paths:
    - wpm-user-sync.php
    - uninstall.php
    - legacy-deprecated.php
    - src

  excludePaths:
    analyse:
      - tests/*
      - vendor/*
      - node_modules/*
      - .wordpress-org/*

  # The plugin's runtime minimum is PHP 8.0 (see Requires PHP in
  # wpm-user-sync.php), so anything newer than 8.0 surfaces here.
  phpVersion: 80000

  # The constants wpm-user-sync.php defines at runtime.
  bootstrapFiles:
    - phpstan-bootstrap.php

  # WP_DEBUG flips per-deployment from wp-config.php. Mark it dynamic
  # so PHPStan does not collapse `if ( WP_DEBUG )` into a constant.
  dynamicConstantNames:
    - WP_DEBUG
