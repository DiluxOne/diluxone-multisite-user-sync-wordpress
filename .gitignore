# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Dependencies
node_modules/
vendor/

# Composer lock file — dev-only deps for testing/linting; CI regenerates
# from composer.json on every run, and tracking it inflates Dependabot
# diffs without runtime benefit (the plugin ships with no vendor/).
composer.lock

# Build artifacts
dist/
build/
*.log

# Test caches and end-to-end results
.phpunit.result.cache
.phpunit.cache/
.phpunit-integration.result.cache
.phpcs-cache/
playwright-report/
test-results/

# Local env
.env
.env.local
.env.*

# wp-env local override (machine-specific dev config)
.wp-env.override.json
