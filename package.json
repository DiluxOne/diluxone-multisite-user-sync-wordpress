{
  "name": "wpm-user-sync-dev",
  "private": true,
  "description": "Local development scripts for DiluxOne Multisite User Sync (wordpress.org slug wpm-user-sync). Not published to npm — only used to pin @wordpress/env and the end-to-end runner for contributors.",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:destroy": "wp-env destroy",
    "env:reset": "wp-env destroy && wp-env start",
    "env:cli": "wp-env run cli",
    "env:logs": "wp-env logs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@wordpress/env": "^11.17.0"
  },
  "overrides": {
    "qs": "6.16.1",
    "sprintf-js": "1.1.3",
    "http-cache-semantics": "4.3.0",
    "js-yaml": "4.1.1"
  }
}
