msgstr "%1$s requer o WordPress %2$s ou superior e foi desativado! Atualize o WordPress e tente novamente. Voltar à %3$s do WordPress."

#. translators: 1: plugin name, 2: link back to plugins page
#: src/RequirementsChecker.php:97
#, php-format
msgid "%1$s requires WordPress Multisite, and has been deactivated! Please configure WordPress for multisite and try again. Back to the WordPress %2$s."
msgstr "%1$s requer o WordPress Multisite e foi desativado! Configure o WordPress para multisite e tente novamente. Voltar à %2$s do WordPress."

#: src/View/Header.php:35
msgid "Welcome to the <strong>best free user synchronization solution</strong> for WordPress Multisite."
msgstr "Bem-vindo à <strong>melhor solução gratuita de sincronização de utilizadores</strong> para o WordPress Multisite."
