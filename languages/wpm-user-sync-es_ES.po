msgid "%1$s requires WordPress Multisite, and has been deactivated! Please configure WordPress for multisite and try again. Back to the WordPress %2$s."
msgstr "%1$s requiere WordPress Multisite y se ha desactivado. Configura WordPress como multisitio e inténtalo de nuevo. Volver a la %2$s de WordPress."

#: src/View/Header.php:35
msgid "Welcome to the <strong>best free user synchronization solution</strong> for WordPress Multisite."
msgstr "Te damos la bienvenida a la <strong>mejor solución gratuita de sincronización de usuarios</strong> para WordPress Multisite."
