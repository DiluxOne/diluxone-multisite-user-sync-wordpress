<?xml version="1.0"?>
<ruleset name="WPM User Sync">
    <description>
        WordPress Coding Standards configuration for the WPM User Sync plugin.
        Strict mode — runs the full WordPress ruleset (Core + Docs + Extra) plus
        PHP 7.4+ compatibility checks. No baseline.
    </description>

    <!-- Files / paths to scan -->
    <file>wpm-user-sync.php</file>
    <file>uninstall.php</file>
    <file>legacy-deprecated.php</file>
    <file>src</file>

    <!-- Files / paths to exclude (mirrors .distignore where applicable) -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/.wordpress-org/*</exclude-pattern>
    <exclude-pattern>*/index.php</exclude-pattern>

    <!-- CLI behaviour -->
    <arg value="sp"/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>
    <arg name="extensions" value="php"/>

    <!-- WordPress Coding Standards: Core, Extra, Docs -->
    <rule ref="WordPress"/>

    <!-- Plugin metadata for naming-convention checks. The legacy code uses the
         `wpmus_` prefix; new OOP code (PR 2 onward) will use the `WPMUS\` PSR-4
         namespace. Both are listed so PHPCS accepts either. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="wpmus"/>
                <element value="WPMUS"/>
                <element value="wpm_user_sync"/>
            </property>
        </properties>
    </rule>

    <!-- Text domain check -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="wpm-user-sync"/>
            </property>
        </properties>
    </rule>

    <!-- =================================================================
         PSR-4 OOP DIRECTORY OVERRIDES
         The src/ tree follows PSR-4 (StudlyCase filenames, one class
         per file, namespace-mapped paths). The default WordPress
         file-naming sniffs expect kebab-case + `class-` prefixes —
         valid for procedural plugin trees, not PSR-4. We turn them
         off only for the src/ directory; the rest of the codebase
         (uninstall.php, wpm-user-sync.php, legacy-deprecated.php)
         still gets the legacy WordPress filename rules.
         ================================================================= -->
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>src/*</exclude-pattern>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- =================================================================
         RULE EXCLUSIONS — deliberate project choices, NOT a baseline.
         Each exclusion below is paired with a justification.
         ================================================================= -->

    <!-- Yoda conditions are explicitly NOT used in this project. -->
    <rule ref="WordPress.PHP.YodaConditions.NotYoda">
        <severity>0</severity>
    </rule>

    <!-- Cosmetic comment formatting rules. Substantive rules
         like FunctionComment.MissingParamTag remain active. -->
    <rule ref="Squiz.Commenting.InlineComment.InvalidEndChar">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting.FunctionComment.ParamCommentFullStop">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting.FunctionComment.MissingParamComment">
        <severity>0</severity>
    </rule>
    <rule ref="Generic.Commenting.DocComment.MissingShort">
        <severity>0</severity>
    </rule>

    <!-- Property and parameter docblocks redundant with PHP 7.4+ typed
         declarations. `private bool $in_sync` is more authoritative
         than `@var bool $in_sync`. Same for parameters: `function f( int $x )`
         conveys exactly what `@param int $x` would. We keep
         FunctionComment.Missing and ClassComment.Missing on, so the
         WHAT and WHY of every function/class is still documented;
         these rules just stop demanding redundant @var / @param
         restatements of information already in the signature. -->
    <rule ref="Squiz.Commenting.VariableComment.Missing">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting.VariableComment.MissingVar">
        <severity>0</severity>
    </rule>
    <rule ref="Squiz.Commenting.FunctionComment.MissingParamTag">
        <severity>0</severity>
    </rule>

    <!-- The plugin's $sd_active_tab legacy global is set in two
         places (NetworkHomePage::render and SiteHomePage::render) for
         backward compatibility with tab-extension hooks. PHPCS flags
         the $GLOBALS write as VariableOverride.Prohibited; the
         override is intentional and there is no other way to expose
         the value to legacy callbacks that read it as a global. -->
    <rule ref="WordPress.WP.GlobalVariablesOverride.Prohibited">
        <exclude-pattern>src/Admin/*HomePage.php</exclude-pattern>
    </rule>

    <!-- Plugin minimum WordPress version (matches readme.txt) -->
    <config name="minimum_supported_wp_version" value="6.6"/>

    <!-- PHP compatibility: must run cleanly on PHP 7.4 and up -->
    <config name="testVersion" value="7.4-"/>
    <rule ref="PHPCompatibilityWP"/>
</ruleset>
